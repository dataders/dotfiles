#!/usr/bin/env python3
"""Open remote OAuth URLs locally and bridge loopback callbacks over SSH."""

import base64
import os
import secrets
import socket
import subprocess
import threading
import time
import urllib.parse
from dataclasses import dataclass, field
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PORT = 17761
MAX_BODY = 64 * 1024
TRANSACTION_TTL = 600
CONTROL_HEADER = "X-Url-Open-Relay"
transactions = {}
transactions_lock = threading.Lock()


class RelayHTTPServer(ThreadingHTTPServer):
    daemon_threads = True
    allow_reuse_address = True


class RelayHTTPServerV6(RelayHTTPServer):
    address_family = socket.AF_INET6


@dataclass
class Transaction:
    transaction_id: str
    callback_port: int
    created_at: float = field(default_factory=time.monotonic)
    callback_ready: threading.Event = field(default_factory=threading.Event)
    acknowledged: threading.Event = field(default_factory=threading.Event)
    request: object = None
    ack_ok: bool = False
    servers: list[RelayHTTPServer] = field(default_factory=list)

    def close(self):
        with transactions_lock:
            transactions.pop(self.transaction_id, None)
        for server in self.servers:
            server.shutdown()
            server.server_close()


def encode(value):
    if isinstance(value, str):
        value = value.encode()
    return base64.b64encode(value).decode("ascii")


def read_form(handler):
    try:
        length = int(handler.headers.get("Content-Length", "0"))
    except ValueError:
        return None
    if length < 0 or length > MAX_BODY:
        return None
    body = handler.rfile.read(length)
    try:
        return urllib.parse.parse_qs(body.decode("utf-8"), keep_blank_values=True)
    except UnicodeDecodeError:
        return None


def get_transaction(transaction_id):
    with transactions_lock:
        transaction = transactions.get(transaction_id)
    if transaction and time.monotonic() - transaction.created_at <= TRANSACTION_TTL:
        return transaction
    return None


def expire_transaction(transaction):
    if not transaction.acknowledged.wait(TRANSACTION_TTL):
        transaction.close()


def bind_callback_servers(transaction):
    servers = []
    try:
        server4 = RelayHTTPServer(("127.0.0.1", transaction.callback_port), CallbackHandler)
        server4.transaction = transaction
        servers.append(server4)
        server6 = RelayHTTPServerV6(("::1", transaction.callback_port), CallbackHandler)
        server6.transaction = transaction
        servers.append(server6)
    except Exception:
        for server in servers:
            server.server_close()
        raise
    transaction.servers = servers
    for server in servers:
        threading.Thread(target=server.serve_forever, daemon=True).start()


class CallbackHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        self._capture(b"")

    def do_POST(self):
        content_type = self.headers.get("Content-Type", "").split(";", 1)[0].strip().lower()
        if content_type != "application/x-www-form-urlencoded":
            self.send_error(415)
            return
        try:
            length = int(self.headers.get("Content-Length", "0"))
        except ValueError:
            self.send_error(400)
            return
        if length < 0 or length > MAX_BODY:
            self.send_error(413)
            return
        self._capture(self.rfile.read(length))

    def _capture(self, body):
        transaction = self.server.transaction
        if transaction.callback_ready.is_set():
            self.send_error(409)
            return
        transaction.request = (
            self.command,
            self.path,
            "application/x-www-form-urlencoded" if self.command == "POST" else "",
            body,
        )
        transaction.callback_ready.set()
        transaction.acknowledged.wait(30)
        ok = transaction.ack_ok
        payload = (
            b"Authentication complete. Return to the terminal."
            if ok
            else b"Could not forward authentication callback. Return to the terminal and retry."
        )
        self.send_response(200 if ok else 502)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(payload)
        threading.Thread(target=transaction.close, daemon=True).start()

    def log_message(self, *_args):
        pass


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        parsed = urllib.parse.urlsplit(self.path)
        if parsed.path == "/open":
            url = urllib.parse.parse_qs(parsed.query).get("url", [""])[0]
            if url.startswith(("http://", "https://")):
                subprocess.run([os.environ.get("URL_OPEN_RELAY_OPEN", "/usr/bin/open"), url], check=False)
                self.send_response(204)
            else:
                self.send_response(400)
            self.end_headers()
            return
        if not self._authorized() or not parsed.path.startswith("/wait/"):
            self.send_error(404)
            return
        transaction = get_transaction(parsed.path.removeprefix("/wait/"))
        if not transaction:
            self.send_error(410)
            return
        if not transaction.callback_ready.wait(TRANSACTION_TTL):
            self.send_error(408)
            return
        method, target, content_type, body = transaction.request
        payload = "\n".join((method, encode(target), encode(content_type), encode(body))) + "\n"
        encoded = payload.encode("ascii")
        self.send_response(200)
        self.send_header("Content-Type", "text/plain; charset=ascii")
        self.send_header("Content-Length", str(len(encoded)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(encoded)

    def do_POST(self):
        parsed = urllib.parse.urlsplit(self.path)
        if not self._authorized():
            self.send_error(404)
            return
        if parsed.path == "/register":
            self._register()
        elif parsed.path.startswith("/ack/"):
            self._ack(parsed.path.removeprefix("/ack/"))
        else:
            self.send_error(404)

    def _authorized(self):
        return self.headers.get(CONTROL_HEADER) == "1"

    def _register(self):
        form = read_form(self)
        if form is None:
            self.send_error(400)
            return
        url = form.get("url", [""])[0]
        callback_port_text = form.get("callback_port", [""])[0]
        parsed_url = urllib.parse.urlsplit(url)
        if parsed_url.scheme not in ("http", "https") or not parsed_url.netloc:
            self.send_error(400)
            return
        if not callback_port_text:
            subprocess.run([os.environ.get("URL_OPEN_RELAY_OPEN", "/usr/bin/open"), url], check=False)
            self._reply_text("-")
            return
        try:
            callback_port = int(callback_port_text)
        except ValueError:
            self.send_error(400)
            return
        if not 1024 <= callback_port <= 65535 or callback_port == PORT:
            self.send_error(400)
            return

        transaction = Transaction(secrets.token_urlsafe(24), callback_port)
        try:
            bind_callback_servers(transaction)
        except OSError:
            self.send_error(409, "callback port unavailable")
            return
        with transactions_lock:
            transactions[transaction.transaction_id] = transaction
        threading.Thread(target=expire_transaction, args=(transaction,), daemon=True).start()
        subprocess.run([os.environ.get("URL_OPEN_RELAY_OPEN", "/usr/bin/open"), url], check=False)
        self._reply_text(transaction.transaction_id)

    def _ack(self, transaction_id):
        transaction = get_transaction(transaction_id)
        form = read_form(self)
        if not transaction or form is None:
            self.send_error(410)
            return
        transaction.ack_ok = form.get("ok", ["0"])[0] == "1"
        transaction.acknowledged.set()
        self.send_response(204)
        self.end_headers()

    def _reply_text(self, text):
        payload = text.encode("ascii")
        self.send_response(200)
        self.send_header("Content-Type", "text/plain; charset=ascii")
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(payload)

    def log_message(self, *_args):
        pass


if __name__ == "__main__":
    RelayHTTPServer(("127.0.0.1", PORT), Handler).serve_forever()
