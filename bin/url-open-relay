#!/usr/bin/env python3
# Loopback relay for remote/bin/xdg-open. Listens on 127.0.0.1 for URLs
# forwarded from remote dev boxes over an SSH RemoteForward tunnel and opens
# them in the default browser here, so browser-based OAuth (databricks,
# gh, gcloud, ...) started on a headless remote box completes on this Mac.
# Kept alive by Library/LaunchAgents/com.dataders.url-open-relay.plist.
import subprocess
import urllib.parse
from http.server import BaseHTTPRequestHandler, HTTPServer

PORT = 17761


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path != "/open":
            self.send_response(404)
            self.end_headers()
            return

        url = urllib.parse.parse_qs(parsed.query).get("url", [""])[0]
        if url.startswith(("http://", "https://")):
            subprocess.run(["open", url], check=False)
            self.send_response(204)
        else:
            self.send_response(400)
        self.end_headers()

    def log_message(self, *_args):
        pass


if __name__ == "__main__":
    HTTPServer(("127.0.0.1", PORT), Handler).serve_forever()
