#!/bin/sh
set -eu

SCRIPT_ARG=$0
case "$SCRIPT_ARG" in
  */*) ;;
  *) SCRIPT_ARG=$(command -v "$SCRIPT_ARG") ;;
esac

while [ -L "$SCRIPT_ARG" ]; do
  LINK_TARGET=$(readlink "$SCRIPT_ARG")
  case "$LINK_TARGET" in
    /*) SCRIPT_ARG=$LINK_TARGET ;;
    *) SCRIPT_ARG=$(CDPATH= cd -- "$(dirname -- "$SCRIPT_ARG")" && pwd)/$LINK_TARGET ;;
  esac
done

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$SCRIPT_ARG")" && pwd)
ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
SCRIPT_PATH="$SCRIPT_DIR/$(basename -- "$SCRIPT_ARG")"

LAB_DIR=${SHADOWTRAFFIC_CLICKHOUSE_DIR:-"$ROOT/shadowtraffic-clickhouse"}
COMPOSE_FILE="$LAB_DIR/compose.yml"
INIT_SQL="$LAB_DIR/init/001-shadowtraffic.sql"
CONFIG_JSON="$LAB_DIR/shadowtraffic/config.json"
DBT_DIR="$LAB_DIR/dbt"
LICENSE_ENV=${SHADOWTRAFFIC_LICENSE_ENV:-"$HOME/Developer/dotfiles_env/shadowtraffic/license.env"}
PROJECT_NAME=${SHADOWTRAFFIC_COMPOSE_PROJECT:-shadowtraffic-clickhouse}
STATE_DIR=${SHADOWTRAFFIC_STATE_DIR:-"${TMPDIR:-/tmp}/shadowtraffic-clickhouse"}
TIMER_PID="$STATE_DIR/timer.pid"
TIMER_CONTAINER="${PROJECT_NAME}-timer"
FS_DBT_BIN=${FS_DBT_BIN:-/Users/dataders/Developer/fs.clickhouse-clean-materialized-views/target/debug/dbt}
DBT_ARTIFACT_DIR=${SHADOWTRAFFIC_DBT_ARTIFACT_DIR:-/private/tmp/shadowtraffic-clickhouse-dbt}
DBT_TARGET_PATH="$DBT_ARTIFACT_DIR/target"
DBT_LOG_PATH="$DBT_ARTIFACT_DIR/logs"

CH_USER=${SHADOWTRAFFIC_CLICKHOUSE_USER:-shadow}
CH_PASSWORD=${SHADOWTRAFFIC_CLICKHOUSE_PASSWORD:-shadow}
CH_HTTP_PORT=${SHADOWTRAFFIC_CLICKHOUSE_HTTP_PORT:-18123}

die() {
  printf '%s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage: shadowtraffic-clickhouse <command> [args]

Lifecycle:
  setup                                      start ClickHouse and create shadowtraffic.events
  start [--for DURATION] [--then stop|destroy] [--no-stream]
                                             start ClickHouse and ShadowTraffic, optionally schedule cleanup
  stop                                       stop ShadowTraffic and ClickHouse, keep volume
  destroy                                    stop services and delete ClickHouse volume
  status                                     show containers and row count

Development:
  sample [N]                                 print N generated events without sending
  query SQL                                  run SQL through clickhouse-client
  dbt-parse                                  parse local dbt source/MV project with fs debug dbt
  dbt-run [selector] [dbt args...]           run local dbt MV project with fs debug dbt

Inspection:
  sql                                        print init SQL
  source-yml                                 print dbt source YAML
  license-path                               print private license.env path
  license-template                           print private license.env template
  check                                      validate local files and Docker Compose config
  duration-seconds DURATION                  parse 30s, 5m, 2h, or bare seconds

Default license path:
  ~/Developer/dotfiles_env/shadowtraffic/license.env
EOF
}

compose() {
  SHADOWTRAFFIC_LICENSE_ENV=$LICENSE_ENV docker compose -p "$PROJECT_NAME" -f "$COMPOSE_FILE" "$@"
}

duration_to_seconds() {
  duration=${1:-}
  [ -n "$duration" ] || die "missing duration"

  case "$duration" in
    *[!0123456789smhd]*)
      die "invalid duration: $duration"
      ;;
    *s)
      number=${duration%s}
      multiplier=1
      ;;
    *m)
      number=${duration%m}
      multiplier=60
      ;;
    *h)
      number=${duration%h}
      multiplier=3600
      ;;
    *d)
      number=${duration%d}
      multiplier=86400
      ;;
    *)
      number=$duration
      multiplier=1
      ;;
  esac

  case "$number" in
    ''|*[!0123456789]*)
      die "invalid duration: $duration"
      ;;
  esac

  printf '%s\n' "$((number * multiplier))"
}

ensure_files() {
  [ -f "$COMPOSE_FILE" ] || die "missing compose file: $COMPOSE_FILE"
  [ -f "$INIT_SQL" ] || die "missing init SQL: $INIT_SQL"
  [ -f "$CONFIG_JSON" ] || die "missing ShadowTraffic config: $CONFIG_JSON"
}

ensure_license() {
  [ -f "$LICENSE_ENV" ] || die "missing ShadowTraffic license: $LICENSE_ENV
Create it from the values provided by ShadowTraffic, or run:
  shadowtraffic-clickhouse license-template > $LICENSE_ENV"
}

wait_clickhouse() {
  i=0
  while [ "$i" -lt 90 ]; do
    if curl -fsS "http://localhost:$CH_HTTP_PORT/ping" >/dev/null 2>&1; then
      return 0
    fi
    i=$((i + 1))
    sleep 1
  done

  die "ClickHouse did not become ready"
}

setup_table() {
  wait_clickhouse
  cmd_query "CREATE DATABASE IF NOT EXISTS shadowtraffic" >/dev/null
  cmd_query "CREATE TABLE IF NOT EXISTS shadowtraffic.events (event_id UUID, customer_id UUID, event_time DateTime64(3, 'UTC'), event_date Date MATERIALIZED toDate(event_time), event_type LowCardinality(String), sku String, amount Decimal(12, 2), quantity UInt16, channel LowCardinality(String), region LowCardinality(String), source LowCardinality(String), ingest_time DateTime64(3, 'UTC') DEFAULT now64(3)) ENGINE = MergeTree ORDER BY (event_time, event_id)" >/dev/null
}

cancel_timer() {
  if [ "${SHADOWTRAFFIC_TIMER_FIRED:-0}" = "1" ]; then
    rm -f "$TIMER_PID"
    return 0
  fi

  docker rm -f "$TIMER_CONTAINER" >/dev/null 2>&1 || true

  if [ -f "$TIMER_PID" ]; then
    pid=$(cat "$TIMER_PID")
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
    fi
    rm -f "$TIMER_PID"
  fi
}

schedule_cleanup() {
  duration=$1
  action=$2
  seconds=$(duration_to_seconds "$duration")

  case "$action" in
    stop|destroy) ;;
    *) die "invalid --then action: $action" ;;
  esac

  mkdir -p "$STATE_DIR"
  cancel_timer

  case "$action" in
    stop)
      timer_cmd="sleep $seconds; docker stop ${PROJECT_NAME}-shadowtraffic-1 ${PROJECT_NAME}-clickhouse-1 >/dev/null 2>&1 || true"
      ;;
    destroy)
      timer_cmd="sleep $seconds; docker compose -p $PROJECT_NAME -f /workspace/compose.yml down -v --remove-orphans"
      ;;
  esac

  docker run -d \
    --rm \
    --name "$TIMER_CONTAINER" \
    --label "com.dataders.shadowtraffic-clickhouse.timer=true" \
    -v /var/run/docker.sock:/var/run/docker.sock \
    -v "$LAB_DIR:/workspace:ro" \
    docker:cli \
    sh -c "$timer_cmd" >/dev/null

  printf 'scheduled %s in %s seconds; timer=%s\n' "$action" "$seconds" "$TIMER_CONTAINER"
}

cmd_setup() {
  ensure_files
  compose up -d clickhouse
  setup_table
  printf 'ready: shadowtraffic.events\n'
}

cmd_start() {
  duration=
  then_action=destroy
  stream=1

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --for)
        shift
        [ "$#" -gt 0 ] || die "missing value for --for"
        duration=$1
        ;;
      --then)
        shift
        [ "$#" -gt 0 ] || die "missing value for --then"
        then_action=$1
        ;;
      --no-stream)
        stream=0
        ;;
      *)
        die "unknown start option: $1"
        ;;
    esac
    shift
  done

  ensure_files
  if [ "$stream" -eq 1 ]; then
    ensure_license
  fi

  compose up -d clickhouse
  setup_table

  if [ "$stream" -eq 1 ]; then
    compose up -d shadowtraffic
    printf 'streaming: shadowtraffic -> clickhouse.shadowtraffic.events\n'
  else
    printf 'ready without stream: shadowtraffic.events\n'
  fi

  if [ -n "$duration" ]; then
    schedule_cleanup "$duration" "$then_action"
  fi
}

cmd_stop() {
  cancel_timer
  compose stop shadowtraffic clickhouse
}

cmd_destroy() {
  cancel_timer
  compose down -v --remove-orphans
}

cmd_status() {
  compose ps
  docker ps -a --filter "name=^/${TIMER_CONTAINER}$" --format 'timer: {{.Status}}' || true
  if compose ps --status running --services | grep -qx clickhouse; then
    cmd_query "SELECT count() AS events FROM shadowtraffic.events" || true
  fi
}

cmd_sample() {
  ensure_files
  ensure_license
  sample_count=${1:-10}
  docker run --rm \
    --env-file "$LICENSE_ENV" \
    -v "$CONFIG_JSON:/home/config.json:ro" \
    shadowtraffic/shadowtraffic:latest \
    --config /home/config.json \
    --sample "$sample_count" \
    --stdout
}

cmd_query() {
  [ "$#" -gt 0 ] || die "missing SQL"
  printf '%s' "$*" | curl -fsS "http://localhost:$CH_HTTP_PORT/?user=$CH_USER&password=$CH_PASSWORD" \
    --data-binary @-
}

cmd_dbt_parse() {
  [ -x "$FS_DBT_BIN" ] || die "missing fs dbt binary: $FS_DBT_BIN"
  "$FS_DBT_BIN" parse --project-dir "$DBT_DIR" --profiles-dir "$DBT_DIR" --target local \
    --target-path "$DBT_TARGET_PATH" --log-path "$DBT_LOG_PATH" --no-write-json
}

cmd_dbt_run() {
  [ -x "$FS_DBT_BIN" ] || die "missing fs dbt binary: $FS_DBT_BIN"
  selector=${1:-mv_event_type_counts}
  if [ "$#" -gt 0 ]; then
    shift
  fi
  "$FS_DBT_BIN" run --project-dir "$DBT_DIR" --profiles-dir "$DBT_DIR" --target local \
    --target-path "$DBT_TARGET_PATH" --log-path "$DBT_LOG_PATH" --no-write-json \
    --select "$selector" "$@"
}

cmd_check() {
  ensure_files
  compose config --quiet
  printf 'files and compose config ok\n'
  if [ -f "$LICENSE_ENV" ]; then
    printf 'license ok: %s\n' "$LICENSE_ENV"
  else
    printf 'license missing: %s\n' "$LICENSE_ENV"
  fi
}

cmd_license_template() {
  cat <<'EOF'
LICENSE_ID=
LICENSE_EMAIL=
LICENSE_ORGANIZATION=
LICENSE_EDITION=
LICENSE_EXPIRATION=
LICENSE_SIGNATURE=
EOF
}

command=${1:-help}
[ "$#" -eq 0 ] || shift

case "$command" in
  help|-h|--help) usage ;;
  setup) cmd_setup "$@" ;;
  start) cmd_start "$@" ;;
  stop) cmd_stop "$@" ;;
  destroy) cmd_destroy "$@" ;;
  status) cmd_status "$@" ;;
  sample) cmd_sample "$@" ;;
  query) cmd_query "$@" ;;
  dbt-parse) cmd_dbt_parse "$@" ;;
  dbt-run) cmd_dbt_run "$@" ;;
  sql) cat "$INIT_SQL" ;;
  source-yml) cat "$DBT_DIR/models/sources.yml" ;;
  license-path) printf '%s\n' "$LICENSE_ENV" ;;
  license-template) cmd_license_template ;;
  check) cmd_check "$@" ;;
  duration-seconds) duration_to_seconds "$@" ;;
  *) die "unknown command: $command" ;;
esac
