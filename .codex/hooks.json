{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "[ -n \"$CMUX_SURFACE_ID\" ] && command -v cmux >/dev/null 2>&1 && cmux codex-hook session-start || echo '{}'",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {"hooks":[{"command":"[ -x /Applications/Shrine.app/Contents/Helpers/shrine-hook ] || exit 0; exec /Applications/Shrine.app/Contents/Helpers/shrine-hook --report codex","timeout":2,"type":"command"}]}
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "[ -n \"$CMUX_SURFACE_ID\" ] && command -v cmux >/dev/null 2>&1 && cmux codex-hook stop || echo '{}'",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {"hooks":[{"command":"[ -x /Applications/Shrine.app/Contents/Helpers/shrine-hook ] || exit 0; exec /Applications/Shrine.app/Contents/Helpers/shrine-hook --report codex","timeout":2,"type":"command"}]}
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "[ -n \"$CMUX_SURFACE_ID\" ] && command -v cmux >/dev/null 2>&1 && cmux codex-hook prompt-submit || echo '{}'",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {"hooks":[{"command":"[ -x /Applications/Shrine.app/Contents/Helpers/shrine-hook ] || exit 0; exec /Applications/Shrine.app/Contents/Helpers/shrine-hook --report codex","timeout":2,"type":"command"}]}
    ],
    "PreToolUse": [{"hooks":[{"command":"[ -x /Applications/Shrine.app/Contents/Helpers/shrine-hook ] || exit 0; exec /Applications/Shrine.app/Contents/Helpers/shrine-hook --report codex","timeout":2,"type":"command"}]}],
    "PermissionRequest": [{"hooks":[{"command":"[ -x /Applications/Shrine.app/Contents/Helpers/shrine-hook ] || exit 0; exec /Applications/Shrine.app/Contents/Helpers/shrine-hook --report codex","timeout":2,"type":"command"}]}],
    "PostToolUse": [{"hooks":[{"command":"[ -x /Applications/Shrine.app/Contents/Helpers/shrine-hook ] || exit 0; exec /Applications/Shrine.app/Contents/Helpers/shrine-hook --report codex","timeout":2,"type":"command"}]}],
    "SessionEnd": [{"hooks":[{"command":"[ -x /Applications/Shrine.app/Contents/Helpers/shrine-hook ] || exit 0; exec /Applications/Shrine.app/Contents/Helpers/shrine-hook --report codex","timeout":2,"type":"command"}]}],
    "Interrupt": [{"hooks":[{"command":"[ -x /Applications/Shrine.app/Contents/Helpers/shrine-hook ] || exit 0; exec /Applications/Shrine.app/Contents/Helpers/shrine-hook --report codex","timeout":2,"type":"command"}]}]
  }
}
