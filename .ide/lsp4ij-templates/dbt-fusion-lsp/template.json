{
  "id": "dbt-fusion-lsp",
  "name": "dbt Fusion LSP",
  "programArgs": {
    "default": "/Users/dataders/.local/bin/dbt lsp --project-dir $PROJECT_DIR$"
  },
  "expandConfiguration": true,
  "fileTypeMappings": [
    {
      "fileType": {
        "name": "SQL",
        "patterns": ["*.sql"]
      },
      "languageId": "sql"
    },
    {
      "fileType": {
        "name": "YAML",
        "patterns": ["*.yml", "*.yaml"]
      },
      "languageId": "yaml"
    },
    {
      "fileType": {
        "name": "Markdown",
        "patterns": ["*.md"]
      },
      "languageId": "markdown"
    }
  ]
}
