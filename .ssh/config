Include /Users/dataders/.ssh/conductor_config

Include /Users/dataders/.colima/ssh_config

Host nectarine01
  HostName 100.74.0.24
  User anders
  AddKeysToAgent yes
  UseKeychain yes
  ForwardAgent yes
  IdentityFile ~/.ssh/id_ed25519
  RemoteForward 17761 127.0.0.1:17761
  LocalForward  8020  127.0.0.1:8020

Host peach01
  HostName 100.74.0.20
  User anders
  AddKeysToAgent yes
  UseKeychain yes
  ForwardAgent yes
  IdentityFile ~/.ssh/id_ed25519
  RemoteForward 17761 127.0.0.1:17761
  # Codex browser OAuth callback: Mac localhost:1455 -> peach01 localhost:1455.
  LocalForward  1455  127.0.0.1:1455
  LocalForward  8020  127.0.0.1:8020
  # Multiplex so `ssh -O forward -L <port>:127.0.0.1:<port> peach01` can inject
  # ad-hoc forwards (e.g. Snowflake externalbrowser's random loopback port)
  # into the existing session instead of opening a colliding new connection.
  ControlMaster auto
  ControlPath ~/.ssh/sockets/%r@%h-%p
  ControlPersist 4h

Host peach01-codex
  HostName 100.74.0.20
  User anders
  IdentityFile ~/.ssh/id_ed25519
  ClearAllForwardings yes

Host github.com
  AddKeysToAgent yes
  UseKeychain yes
  IdentityFile ~/.ssh/id_ed25519
